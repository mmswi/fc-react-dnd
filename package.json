{
  "name": "fc-react-dnd",
  "version": "0.1.0",
  "description": "A React drag-and-drop library with first-class tree support: drop-into vs drop-between, depth projection, and cycle prevention as pure functions.",
  "license": "MIT",
  "author": "Mihai Marinescu",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./package.json": "./package.json",
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./collision": {
      "types": "./dist/collision.d.ts",
      "default": "./dist/collision.js"
    },
    "./dnd-provider": {
      "types": "./dist/dnd-provider.d.ts",
      "default": "./dist/dnd-provider.js"
    },
    "./use-draggable": {
      "types": "./dist/use-draggable.d.ts",
      "default": "./dist/use-draggable.js"
    },
    "./use-droppable": {
      "types": "./dist/use-droppable.d.ts",
      "default": "./dist/use-droppable.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "check:package": "publint && attw --pack . --profile esm-only",
    "verify": "bun run typecheck && bun run check && bun run test && bun run build && bun run check:package"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@biomejs/biome": "^2.5.7",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "jsdom": "^26.1.0",
    "publint": "^0.3.14",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "react",
    "drag-and-drop",
    "dnd",
    "sortable",
    "tree",
    "nested",
    "accessibility"
  ],
  "workspaces": [
    "playground"
  ]
}
